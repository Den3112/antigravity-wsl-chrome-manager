#! /bin/bash

# =============================================================================
# Antigravity Smart Proxy Manager
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd) || exit"
PROXY_SCRIPT="$SCRIPT_DIR/smart_chrome_proxy.py"
LOG_FILE="/tmp/smart_proxy.log"

case "$1" in
    status)
        echo "🔍 Checking Antigravity Proxy..."
        PID=$(pgrep -f "smart_chrome_proxy.py")
        if [ -n "$PID" ]; then
            echo "✅ Smart Proxy is active (PID: $PID)"
            echo "   Route: 127.0.0.1:9222 (Stealth Bridge) -> Proxy"
        else
            echo "❌ Smart Proxy is NOT running"
        fi
        
        echo ""
        echo "🔍 Checking Chrome instances..."
        # Check for any Chrome running under the Antigravity profile
        CHROME_PIDS=$(pgrep -f "antigravity_chrome")
        if [ -n "$CHROME_PIDS" ]; then
             echo "✅ Chrome is running (Managed by Proxy)"
        else
             echo "💤 Chrome is sleeping (Auto-starts on demand)"
        fi
        ;;
        
    start)
        if pgrep -f "smart_chrome_proxy.py" > /dev/null; then
            echo "⚠️  Proxy is already running."
        else
            if [ -f "$PROXY_SCRIPT" ]; then
                echo "🚀 Starting Smart Proxy..."
                nohup python3 "$PROXY_SCRIPT" > "$HOME/smart_proxy.log" 2>&1 &
                echo "✅ Started background service."
            else
                echo "❌ Proxy script not found: $PROXY_SCRIPT"
            fi
        fi
        ;;
        
    stop)
        echo "🛑 Stopping services..."
        pkill -f "smart_chrome_proxy.py" || true
        pkill -f "chrome.*antigravity" 2>/dev/null || true
        echo "✅ All stopped."
        ;;
        
    restart)
        echo "🔄 Restarting..."
        $0 stop
        sleep 1
        $0 start
        ;;
        
    logs)
        echo "📋 Proxy Logs:"
        tail -n 20 "$LOG_FILE" 2>/dev/null
        ;;
        
    *)
        echo "Usage: chrome-ctl {status|start|stop|restart|logs}"
        exit 1
        ;;
esac
